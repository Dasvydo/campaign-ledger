# campaign-ledger - copy to .env and fill in. Never commit .env.
#
# The ledger lives in the LEAD-PIPELINE Supabase project, in schema `campaign`.
# It is NOT the product project. If the ref below ever reads
# kngcxwcybozgqgnoweyt, stop: that is the product database (Frankfurt) and
# src/campaign_db.py will refuse to connect to it.
#
# The lead-pipeline project is oqpeebtwtikdzorgouxd, confirmed by Dovy on
# 2026-09-06 (BLOCKED.md B-1, resolved). Still check the ref in the URL bar
# before filling this in.

# Project REST URL, e.g. https://oqpeebtwtikdzorgouxd.supabase.co
SUPABASE_URL=

# The SERVICE ROLE key. Server side only.
#
# Note the variable name: SUPABASE_SERVICE_KEY, not SUPABASE_SERVICE_ROLE_KEY.
# That is deliberate. Several environments already export
# SUPABASE_SERVICE_ROLE_KEY pointing at the product project, and reading a
# different name means the ledger can never pick that one up by accident.
#
# This key bypasses row level security and can read every contact, work email
# and phone number in the schema. It must never reach a browser, a client
# bundle, an n8n node that renders into a page, or a log line.
SUPABASE_SERVICE_KEY=
